    "@types/react-dom": "19.2.5",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
