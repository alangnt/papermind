{
  "name": "papermind",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "prepare": "husky",
    "format": "prettier --write .",
    "knip": "knip",
    "db:indexes": "node --env-file=.env.local scripts/ensure-indexes.mjs",
    "db:indexes:check": "node --env-file=.env.local scripts/ensure-indexes.mjs --dry-run",
    "lint:fix": "eslint . --fix",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude '**/*.db.test.ts'"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.35",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.87",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "knip": "^6.34.0",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.6.0",
    "motion": "^12.43.0",
    "next": "16.3.4",
    "postmark": "^4.0.7",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "xml2js": "^0.6.2"
